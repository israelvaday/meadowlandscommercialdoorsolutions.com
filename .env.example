# --- Static site (GitHub Pages build) ---
NEXT_EXPORT=1
NEXT_PUBLIC_GH_PAGES=1
NEXT_PUBLIC_SITE_URL=https://meadowlandscommercialdoorsolutions.com
NEXT_PUBLIC_QUOTE_API_URL=https://meadowlandscommercialdoorsolutions.com/api/quote

# --- Quote email (Cloudflare Worker + Email Routing) ---
QUOTE_TO_EMAIL=bar.izhaki@gmail.com
QUOTE_FORWARD_EMAILS=bar.izhaki@gmail.com
QUOTE_FROM_EMAIL=Meadowlands Commercial Door Solutions <quotes@meadowlandscommercialdoorsolutions.com>

# --- Cloudflare deploy (local scripts only — never commit real tokens) ---
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DNS_API_TOKEN=
CLOUDFLARE_EMAIL_API_TOKEN=

# OpenRouter (local scripts only)
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=google/gemini-3-pro-image-preview
